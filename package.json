{
  "name": "bivium",
  "version": "0.6.0",
  "description": "Run only the tests a change can affect, and never miss one.",
  "license": "MIT",
  "author": "Eric Liu (https://github.com/metonym)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metonym/bivium.git"
  },
  "homepage": "https://github.com/metonym/bivium",
  "bugs": "https://github.com/metonym/bivium/issues",
  "keywords": [
    "test",
    "test-selection",
    "test-impact-analysis",
    "affected",
    "changed",
    "dependency-graph",
    "ci",
    "vitest",
    "playwright",
    "zero-dependency"
  ],
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "bivium": "cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false
}
